{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "nanai-android-mascot",
	"version": "0.1.0",
	"identifier": "com.nanai-android-mascot.app",
	"build": {
		"frontendDist": "../ui"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "Nanai Android Mascot",
				"width": 400,
				"height": 600,
				"transparent": true,
				"decorations": false,
				"alwaysOnTop": true,
				"resizable": true,
				"minimizable": false,
				"maximizable": false,
				"visible": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"active": false
		}
	}
}
