{
	"type": "module",
	"scripts": {
		"dev": "npm run build:wasm && vite",
		"build:wasm": "wasm-pack build crates/nanai-core --target web --out-dir ui/ts/core/wasm/pkg --dev",
		"build": "npm run build:wasm && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "npm run build:wasm && vitest run",
		"test:ui": "vitest",
		"verify": "node --experimental-strip-types scripts/verify-implementation.ts",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.0.5",
		"markuplint": "^5.5.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.3"
	}
}
