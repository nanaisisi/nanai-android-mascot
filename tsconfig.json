{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowJs": true,
		"types": ["node", "vitest/globals"]
	},
	"include": ["ui/**/*.ts", "tests/**/*.ts"],
	"exclude": ["node_modules", "target", "src-tauri"]
}
