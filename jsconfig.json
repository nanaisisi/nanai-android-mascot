{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"checkJs": true,
		"allowJs": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noEmit": true
	},
	"include": ["ui/**/*.js"],
	"exclude": ["node_modules", "target", "src-tauri"]
}
